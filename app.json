{
  "expo": {
    "name": "FindPets",
    "slug": "find-pets",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.irlamfernandes.findpets",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O FindPets precisa acessar suas fotos para anexar imagens do pet desaparecido.",
          "cameraPermission": "O FindPets precisa da câmera para fotografar o pet desaparecido."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O FindPets usa sua localização para marcar onde o pet desapareceu."
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "f0bc1f8a-cffd-4f6b-ad1c-937a6bd4968a"
      }
    },
    "owner": "irlam"
  }
}
