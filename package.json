{
  "name": "FindPets",
  "slug": "find-pets",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --ci --coverage",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "**/*.{js,jsx}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/babel.config.js",
      "!**/eslint.config.js",
      "!**/commitlint.config.js",
      "!**/index.js",
      "!**/App.js",
      "!**/jest.setup.js",
      "!**/jest.globalSetup.js",
      "!**/src/testing/**",
      "!api/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testTimeout": 15000,
    "globalSetup": "./jest.globalSetup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/api/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/api/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "bcryptjs": "^3.0.3",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "firebase": "^13.1.0",
    "jest-expo": "~58.0.12",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "sql.js": "^1.15.1"
  }
}
